# AWS region (e.g. eu-west-1)
AWS_REGION=eu-west-1

# AWS credentials (use IAM role in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock Agent resource ID
BEDROCK_AGENT_ID=

# Bedrock Agent alias ID
BEDROCK_AGENT_ALIAS_ID=

# DynamoDB table name for chat history
DYNAMODB_TABLE_NAME=

# Lambda function name for presigned URL generation
UPLOAD_LAMBDA_NAME=

# Display name shown in sidebar and welcome screen
NEXT_PUBLIC_APP_NAME=Knowledge Assistant
